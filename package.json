{
  "name": "youtube-dl-material",
  "version": "4.3.2",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "prebuild": "node src/postbuild.mjs",
    "lint": "eslint src backend",
    "generate": "openapi --input ./\"Public API v1.yaml\" --output ./src/api-types --exportCore false --exportServices false --exportModels true",
    "i18n-source": "ng extract-i18n --output-path=src/assets/i18n --out-file=messages.en.xlf"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.2.6",
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/localize": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/platform-browser-dynamic": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@ngneat/content-loader": "^7.0.0",
    "@videogular/ngx-videogular": "^20.0.0",
    "crypto-js": "^4.2.0",
    "file-saver": "^2.0.5",
    "filesize": "^11.0.32",
    "fs-extra": "^11.4.1",
    "material-icons": "^1.13.14",
    "ngx-avatars": "^1.10.3",
    "ngx-file-drop": "^16.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "xliff-to-json": "^1.1.0",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@angular/language-service": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@types/file-saver": "^2.0.7",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "openapi-typescript-codegen": "^0.31.0",
    "typescript-eslint": "^8.72.2"
  },
  "overrides": {
    "@videogular/ngx-videogular": {
      "@angular/common": "$@angular/common",
      "@angular/core": "$@angular/core",
      "zone.js": "$zone.js"
    }
  }
}
